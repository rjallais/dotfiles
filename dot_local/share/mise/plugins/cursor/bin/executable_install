#!/usr/bin/env bash
set -euo pipefail

# Make sure the bin directory exists in install path
mkdir -p "$ASDF_INSTALL_PATH/bin"

# Move the downloaded cursor AppImage to the install bin directory
cp "$ASDF_DOWNLOAD_PATH/cursor" "$ASDF_INSTALL_PATH/bin/cursor"

echo "Cursor successfully installed to $ASDF_INSTALL_PATH/bin/cursor"
