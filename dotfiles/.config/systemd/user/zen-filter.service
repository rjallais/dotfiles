[Unit]
Description=Zen Filter — system-wide MITM ad-blocker/privacy proxy (headless)
PartOf=graphical-session.target
ConditionFileIsExecutable=%h/.local/bin/zen-filter-bg

[Service]
Type=simple
ExecStart=%h/.local/bin/zen-filter-bg
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target